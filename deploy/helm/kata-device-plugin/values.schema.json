{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
    "hostPaths": {
      "additionalProperties": false,
      "properties": {
        "cdi": {
          "default": "",
          "pattern": "^(|/[^\\r\\n]+)$",
          "type": "string"
        },
        "devicePlugin": {
          "default": "",
          "pattern": "^(|/[^\\r\\n]+)$",
          "type": "string"
        }
      },
      "required": [
        "devicePlugin",
        "cdi"
      ],
      "type": "object"
    },
    "k8sDistribution": {
      "default": "k8s",
      "enum": [
        "k8s",
        "k3s",
        "rke2",
        "k0s",
        "microk8s"
      ],
      "type": "string"
    },
    "resourceNaming": {
      "default": "alias",
      "enum": [
        "alias",
        "sku"
      ],
      "type": "string"
    }
  },
  "type": "object"
}
